---
import BaseLayout from '~/layouts/BaseLayout.astro';

const description =
  '筆が遅くても、楽しみながら続けられるクロッキータイマー。30秒・1分・5分の時間設定とXP・バッジで、絵の練習を毎日の習慣に。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'KAKUZE',
    url: 'https://kakuze-v2.vercel.app/',
    description,
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'KAKUZE',
    applicationCategory: 'EducationApplication',
    operatingSystem: 'Web',
    description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'JPY',
    },
  },
];

const articles = [
  {
    slug: 'start-guide',
    chip: 'START GUIDE · 8 min',
    title: 'クロッキー、最初の30秒に何を見るか。',
    date: '2026-04-12',
    cover: 'a',
  },
  {
    slug: 'time-settings',
    chip: 'DEEP DIVE · 12 min',
    title: '30秒・1分・5分を、何のために分けるのか。',
    date: '2026-04-08',
    cover: 'b',
  },
  {
    slug: 'daily-habit',
    chip: 'HABIT · 6 min',
    title: '毎日続けるコツは、目標設定の小ささにある。',
    date: '2026-04-02',
    cover: 'c',
  },
];

const fmt = (iso: string) => iso.replace(/-/g, '.');
---

<BaseLayout title="KAKUZE" description={description} jsonLd={jsonLd}>
  {/* ===================== HERO ===================== */}
  <section class="hero">
    <span class="hero__sidemark" aria-hidden="true">VOLUME 02 — CROQUIS · POMODORO · XP</span>
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__overline">
          <span class="hero__num">№ 001</span>
          <span>Tool — Croquis Timer</span>
        </p>
        <h1 class="hero__title">
          筆が遅くても、<br />
          楽しみながら続けられる<br />
          <em>クロッキータイマー</em>。
        </h1>
        <p class="hero__sub">
          30秒・1分・5分。<br />
          画力を鍛える時間制限のセッションを、XPとレベルとバッジで可視化する。
          記事ガイドつきで、初めての一枚から続く一年まで。
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="/app">
            アプリを使う
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a class="btn btn--ghost" href="/guide">使い方を読む</a>
          <a class="tertiary-link" href="/about">クロッキーとは？</a>
        </div>
        <div class="hero__meta tabular">
          <span>無料 / 会員登録不要</span>
          <span>ローカル保存 / Drive連携対応</span>
          <span>117種のバッジ</span>
        </div>
      </div>

      <aside class="hero__object" aria-hidden="true">
        <div class="timer-card">
          <div class="timer-card__head">
            <span>SESSION 03 / 12</span>
            <span class="tag">CROQUIS</span>
          </div>
          <div class="timer-card__face">
            <div class="timer-card__ring"></div>
            <div class="timer-card__num tabular">
              00:48<small>.21</small>
            </div>
          </div>
          <div class="timer-card__foot tabular">
            <span>+96 XP / Lv.07</span>
            <span>5:00 / SET</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {/* ===================== STATS ===================== */}
  <section class="stats" aria-label="数字でみるKAKUZE">
    <div class="stats__inner">
      <div>
        <p class="stat__num tabular">2 / sec</p>
        <p class="stat__label">Croquis XP</p>
      </div>
      <div>
        <p class="stat__num tabular">117</p>
        <p class="stat__label">Badges</p>
      </div>
      <div>
        <p class="stat__num tabular">6</p>
        <p class="stat__label">Modes</p>
      </div>
      <div>
        <p class="stat__num tabular">0¥</p>
        <p class="stat__label">Cost</p>
      </div>
    </div>
  </section>

  {/* ===================== FEATURES ===================== */}
  <section class="section">
    <div class="container-wide">
      <div class="section__head">
        <p class="section__overline">№ 002 — Tools</p>
        <h2 class="section__title">道具は、3つでいい。</h2>
        <p class="section__lede">
          集中するためのタイマー。休むためのポモドーロ。続けるための実績。
          余計なものは置かない。
        </p>
      </div>

      <div class="features">
        <article class="feature">
          <span class="feature__num">01</span>
          <svg class="feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <circle cx="12" cy="13" r="8" />
            <path d="M12 13V8M12 1v3M9 1h6" />
          </svg>
          <h3 class="feature__title">クロッキータイマー</h3>
          <p class="feature__body">
            30秒・1分・5分など自由な時間設定で。
            お手本観察・固定画像・タイマーのみの3モード、
            ローカルフォルダ・クラウドURL・Google Drive から画像を読み込める。
          </p>
          <p class="feature__meta">6 modes · IndexedDB · Drive 連携</p>
        </article>

        <article class="feature">
          <span class="feature__num">02</span>
          <svg class="feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M12 22V12M12 12c-4.5-1-7-4.5-7-9 4.5 1 7 4.5 7 9zM12 12c4.5-1 7-4.5 7-9-4.5 1-7 4.5-7 9z" />
          </svg>
          <h3 class="feature__title">ポモドーロ</h3>
          <p class="feature__body">
            25分作業 + 5分休憩を自動運用。
            作業時間 / 休憩時間 / サイクル数は任意設定。
            長時間の練習でも疲れにくい。
          </p>
          <p class="feature__meta">XP 1/sec · 自動フェーズ遷移</p>
        </article>

        <article class="feature">
          <span class="feature__num">03</span>
          <svg class="feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <circle cx="12" cy="9" r="6" />
            <path d="M9 14l-2 8 5-3 5 3-2-8" />
          </svg>
          <h3 class="feature__title">XP・実績・バッジ</h3>
          <p class="feature__body">
            クロッキー1秒=2XP、ポモドーロ1秒=1XP。
            117種類のバッジ・称号・連続記録で、続けた日数を可視化する。
          </p>
          <p class="feature__meta">Level 1000+ · Streak Title</p>
        </article>
      </div>
    </div>
  </section>

  {/* ===================== EDITORIAL ===================== */}
  <section class="section section--alt">
    <div class="container">
      <div class="editorial">
        <p class="editorial__overline">№ 003 — Note from the editor</p>
        <div class="editorial__body">
          <p>
            画力は、特別な道具ではなく、たった一本の鉛筆と紙、そして「短い時間で線を決める」訓練の積み重ねでつくられる。
            クロッキーは、その積み重ねを、いちばん短い単位で要求する練習だ。
          </p>
          <div class="editorial__rule"></div>
          <p>
            KAKUZE は、その練習を毎日の習慣にするための小さな道具にすぎない。
            時間を測ること、続いた日数を数えること、続けた人にだけ見える景色を可視化すること。
            ツール側の仕事はそこまでで、線を引くのはあなたの仕事だ。
          </p>
          <p>
            だから装飾は最小限に、文字は読みやすく、ボタンは押し間違えない場所に。
            気が散る要素はすべて削った。あとは、はじめるだけ。
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ===================== ARTICLES ===================== */}
  <section class="section">
    <div class="container-wide">
      <div class="section__head">
        <p class="section__overline">№ 004 — Journal</p>
        <h2 class="section__title">続けるためのガイド。</h2>
        <p class="section__lede">
          クロッキーの基礎、時間設定の使い分け、参考資料の選び方。
          続けるための知識を、編集者が自分の手で書いている。
        </p>
      </div>

      <div class="articles">
        {articles.map((a) => (
          <article class="article">
            <div class={`article__cover article__cover--${a.cover}`} aria-hidden="true"></div>
            <p class="article__chip">{a.chip}</p>
            <h3 class="article__title">
              <a href={`/blog/${a.slug}`}>{a.title}</a>
            </h3>
            <p class="article__meta">
              <time datetime={a.date}>{fmt(a.date)}</time>
              <span>by へんしゅうちょ</span>
            </p>
            <a class="article__more" href={`/blog/${a.slug}`}>
              続きを読む
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ===================== AUTHOR ===================== */}
  <section class="section section--alt">
    <div class="container">
      <article class="author">
        <div class="author__body">
          <p class="author__quote">
            イラスト歴は10年。それでも筆は遅い。<br />
            だから、自分のために KAKUZE を作った。
            続いた日数を数えてくれる道具が、ほしかったから。
          </p>
          <div class="author__meta">
            <div>
              <p class="author__name">かゅう / へんしゅうちょ</p>
              <p class="author__sub">Editor / Developer · Tokyo</p>
            </div>
          </div>
        </div>
        <div class="author__portrait" aria-hidden="true"></div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
   * HERO
   * ============================================================ */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
    border-bottom: 1px solid var(--color-rule);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-16);
    }
  }
  .hero__overline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-6);
  }
  .hero__overline::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--color-ink-muted);
  }
  .hero__num {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: 0.05em;
  }
  .hero__title {
    font-size: var(--text-hero);
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--color-ink);
    margin: 0 0 var(--space-8);
  }
  .hero__title em {
    font-style: normal;
    background: linear-gradient(180deg, transparent 64%, oklch(85% 0.06 90 / 0.6) 64%);
    padding: 0 0.05em;
  }
  .hero__sub {
    font-size: var(--text-lg);
    line-height: 1.85;
    color: var(--color-ink-muted);
    max-width: 28em;
    margin: 0 0 var(--space-8);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-8);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    letter-spacing: 0.06em;
  }
  .hero__meta span::before {
    content: "/ ";
    color: var(--color-ink-faint);
    margin-right: 2px;
  }

  .hero__sidemark {
    position: absolute;
    right: var(--container-gutter);
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: right top;
    font-size: var(--text-xs);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    display: none;
  }
  @media (min-width: 1280px) {
    .hero__sidemark { display: block; }
  }

  /* ============================================================
   * BUTTONS
   * ============================================================ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
    font-weight: 500;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--duration-fast) var(--ease-standard),
      background var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }
  .btn--primary {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-sm);
  }
  .btn--primary:hover {
    background: var(--color-accent);
    color: #fff;
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }
  .btn--primary:active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .btn--ghost:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .btn--ghost:active { transform: translateY(1px); }
  .tertiary-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    text-decoration: none;
  }
  .tertiary-link:hover { color: var(--color-ink); }

  /* ============================================================
   * TIMER CARD (hero object)
   * ============================================================ */
  .hero__object {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 460px;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }
  .timer-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-8);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    overflow: hidden;
  }
  .timer-card::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px solid var(--color-border);
    pointer-events: none;
  }
  .timer-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .timer-card__face {
    display: grid;
    place-items: center;
    position: relative;
  }
  .timer-card__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.5rem, 6vw + 1rem, 6rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    font-feature-settings: "tnum" 1;
  }
  .timer-card__num small {
    font-size: 0.5em;
    color: var(--color-ink-muted);
  }
  .timer-card__ring {
    position: absolute;
    inset: 8% 8%;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    pointer-events: none;
  }
  .timer-card__ring::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: conic-gradient(var(--color-ink) 0 62%, transparent 62%);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    mask: radial-gradient(closest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    opacity: 0.85;
  }
  .timer-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.05em;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 2px var(--space-2);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.6875rem;
    font-weight: 500;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  /* ============================================================
   * STATS BAR
   * ============================================================ */
  .stats {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-paper-deep);
  }
  .stats__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-8);
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }
  @media (min-width: 768px) {
    .stats__inner { grid-template-columns: repeat(4, 1fr); }
  }
  .stat__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-feature-settings: "tnum" 1;
    margin: 0;
  }
  .stat__label {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: var(--space-1) 0 0;
  }

  /* ============================================================
   * SECTION COMMON
   * ============================================================ */
  .section { padding-block: var(--space-section); }
  .section--alt {
    background: var(--color-paper-deep);
    border-block: 1px solid var(--color-border);
  }
  .section__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }
  .section__overline {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .section__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    max-width: 18em;
    margin: 0;
  }
  .section__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    line-height: 1.85;
    max-width: 32em;
    margin: 0;
  }

  /* ============================================================
   * FEATURES
   * ============================================================ */
  .features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-block: 1px solid var(--color-rule);
  }
  @media (min-width: 768px) {
    .features { grid-template-columns: repeat(3, 1fr); }
  }
  .feature {
    position: relative;
    padding: var(--space-12) var(--space-6);
    display: grid;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .feature:last-child { border-bottom: 0; }
  @media (min-width: 768px) {
    .feature {
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }
    .feature:last-child { border-right: 0; }
  }
  .feature__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-xl);
    color: var(--color-ink-muted);
    letter-spacing: 0.02em;
  }
  .feature__icon {
    width: 32px;
    height: 32px;
    color: var(--color-ink);
    margin-top: var(--space-2);
  }
  .feature__title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: var(--space-2) 0 0;
  }
  .feature__body {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    line-height: 1.85;
    margin: 0;
  }
  .feature__meta {
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: var(--space-2) 0 0;
  }

  /* ============================================================
   * EDITORIAL PARAGRAPH
   * ============================================================ */
  .editorial {
    max-width: var(--container-tight);
    margin-inline: auto;
    text-align: left;
  }
  .editorial__overline {
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-6);
  }
  .editorial__body {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 2;
    color: var(--color-ink);
  }
  .editorial__body p { margin: 0 0 var(--space-6); }
  .editorial__body p:first-of-type::first-letter {
    font-family: var(--font-display);
