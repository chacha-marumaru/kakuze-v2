---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import AuthorCard from '~/components/AuthorCard.astro';
import RelatedArticles from '~/components/RelatedArticles.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const { Content } = await post.render();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: {
      '@type': 'Person',
      name: post.data.author,
      url: 'https://kakuze-v2.vercel.app/about-us',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://kakuze-v2.vercel.app/' },
      { '@type': 'ListItem', position: 2, name: 'ブログ', item: 'https://kakuze-v2.vercel.app/blog' },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.heroImage}
  jsonLd={jsonLd}
>
  <Breadcrumb
    items={[
      { label: 'ホーム', href: '/' },
      { label: 'ブログ', href: '/blog' },
      { label: post.data.title },
    ]}
  />
  <article class="article-detail">
    <header class="article-detail__header">
      {post.data.heroImage && (
        <img
          class="article-detail__hero"
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
          width={1200}
          height={630}
        />
      )}
      <div class="article-detail__meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.updatedDate && (
          <span class="article-detail__updated">
            （更新: <time datetime={post.data.updatedDate.toISOString()}>
              {post.data.updatedDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>）
          </span>
        )}
      </div>
      <h1 class="article-detail__title">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <ul class="tag-list">
          {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}
    </header>
    <div class="article-detail__body prose">
      <Content />
    </div>
    <footer class="article-detail__footer">
      <AuthorCard name={post.data.author} />
      <RelatedArticles currentSlug={post.slug} allPosts={allPosts} />
    </footer>
  </article>
</BaseLayout>

<style>
  .article-detail {
    max-width: 48rem;
    margin-inline: auto;
    padding-block: var(--space-12);
    padding-inline: var(--space-6);
  }

  .article-detail__header {
    margin-bottom: var(--space-10);
  }

  .article-detail__hero {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    margin-bottom: var(--space-6);
  }

  .article-detail__meta {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }

  .article-detail__updated {
    margin-inline-start: var(--space-2);
  }

  .article-detail__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .tag-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 2px;
    padding: 2px var(--space-2);
  }

  .article-detail__body {
    line-height: var(--leading-loose);
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    margin-block: var(--space-8) var(--space-4);
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-block: var(--space-6) var(--space-3);
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-block-end: var(--space-5);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.5em;
    margin-block-end: var(--space-5);
  }

  .prose :global(li) {
    margin-block-end: var(--space-2);
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    opacity: 0.8;
  }

  .prose :global(blockquote) {
    border-inline-start: 3px solid var(--color-border);
    padding-inline-start: var(--space-4);
    color: var(--color-text-muted);
    margin-inline: 0;
    margin-block: var(--space-5);
  }

  .article-detail__footer {
    margin-block-start: var(--space-12);
  }
</style>
