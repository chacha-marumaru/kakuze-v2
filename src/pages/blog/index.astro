---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ブログ | KAKUZE',
  description: 'クロッキー・ポモドーロ練習に役立つ記事一覧',
  url: 'https://kakuze-v2.vercel.app/blog',
};
---

<BaseLayout
  title="ブログ | KAKUZE"
  description="クロッキー・ポモドーロ練習に役立つ記事一覧"
  jsonLd={jsonLd}
>
  <Breadcrumb items={[{ label: 'ホーム', href: '/' }, { label: 'ブログ' }]} />
  <div class="blog-index">
    <h1 class="blog-index__title">ブログ</h1>
    <ul class="post-list">
      {allPosts.map((post) => (
        <li class="post-card">
          <a href={`/blog/${post.slug}`} class="post-card__link">{post.data.title}</a>
          <p class="post-card__desc">{post.data.description}</p>
          <time class="post-card__date" datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('ja-JP')}
          </time>
          {post.data.tags.length > 0 && (
            <ul class="tag-list">
              {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .blog-index {
    max-width: 48rem;
    margin-inline: auto;
    padding-block: var(--space-12);
    padding-inline: var(--space-6);
  }

  .blog-index__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .post-card {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-8);
  }

  .post-card__link {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .post-card__link:hover {
    color: var(--color-accent);
  }

  .post-card__desc {
    margin-block-start: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-base);
  }

  .post-card__date {
    display: block;
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .tag-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 2px;
    padding: 2px var(--space-2);
  }
</style>
